{
  "name": "la-verde-gestion",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "icons": "node scripts/icons.mjs",
    "test": "vitest run && vitest run --config vitest.client.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "preact": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
